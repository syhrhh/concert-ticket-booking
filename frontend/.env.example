# The Vite dev server uses its built-in /gateway/* proxy by default.
# If your group deploys the frontend independently, set real browser-accessible
# URLs here (not Docker-only hostnames) or configure an equivalent reverse proxy.
# VITE_AVAILABILITY_API=http://localhost:5002
# VITE_BOOKING_API=http://localhost:5001
# VITE_NOTIFICATION_API=http://localhost:5003
